global:
  scrape_interval: 10s
  evaluation_interval: 10s

rule_files:
  - /etc/prometheus/rules.yml

# Every target serves TLS from the lab CA and is verified against it; the certificates carry the
# addresses as SANs, so the targets stay addresses (ADR-0010).
scrape_configs:
  - job_name: patroni
    scheme: https
    tls_config:
      ca_file: /etc/prometheus/ca.crt
    static_configs:
      - targets:
{% for h in groups['etcd_nodes'] %}
          - "{{ hostvars[h]['ansible_host'] }}:8008"
{% endfor %}
  - job_name: postgres
    scheme: https
    tls_config:
      ca_file: /etc/prometheus/ca.crt
    static_configs:
      - targets:
{% for h in groups['etcd_nodes'] %}
          - "{{ hostvars[h]['ansible_host'] }}:9187"
{% endfor %}
  - job_name: haproxy
    scheme: https
    tls_config:
      ca_file: /etc/prometheus/ca.crt
    static_configs:
      - targets:
{% for h in groups['balancers'] %}
          - "{{ hostvars[h]['ansible_host'] }}:8404"
{% endfor %}
  - job_name: prometheus
    scheme: https
    tls_config:
      ca_file: /etc/prometheus/ca.crt
    static_configs:
      - targets: ["localhost:9090"]
