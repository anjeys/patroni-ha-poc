---
# scripts/lab.sh generates group_vars/all/secrets.yml with these keys (SECRET_KEYS in lab.sh,
# one per password or passphrase a role needs) and encrypts it with ansible-vault (.vault_pass,
# gitignored). Shape only.
pg_superuser_password: "CHANGE_ME"
pg_replication_password: "CHANGE_ME"
patroni_restapi_password: "CHANGE_ME"
pgbouncer_auth_password: "CHANGE_ME"
etcd_root_password: "CHANGE_ME"
etcd_patroni_password: "CHANGE_ME"
pg_exporter_password: "CHANGE_ME"
pgbackrest_cipher_pass: "CHANGE_ME"
